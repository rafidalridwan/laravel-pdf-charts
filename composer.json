{
    "name": "ridwan/laravel-pdf-charts",
    "description": "A convenient Laravel wrapper for generating chart images.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "quickchart",
        "charts",
        "pdf",
        "chart.js"
    ],
    "authors": [
        {
            "name": "Rafid Al Ridwan",
            "email": "rafidalridwan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ridwan\\LaravelPdfCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ridwan\\LaravelPdfCharts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ridwan\\LaravelPdfCharts\\ChartServiceProvider"
            ],
            "aliases": {
                "Chart": "Ridwan\\LaravelPdfCharts\\Facades\\Chart"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
